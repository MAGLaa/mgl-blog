---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { siteConfig } from '../config/site.js';

const { 
  title: defaultTitle, 
  description: defaultDescription, 
  base,
  nav,
  footer 
} = siteConfig;

const { 
  title, 
  description,
  ogImage 
} = Astro.props;

const pageTitle = title ? `${title} | ${defaultTitle}` : defaultTitle;
const pageDescription = description || defaultDescription;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" href={`${base}logo.svg`} />
    <meta name="theme-color" content="#8d7b9e" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={defaultTitle} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    
    <title>{pageTitle}</title>
  </head>
  <body>
    <!-- 导航栏 -->
    <nav class="nav">
      <div class="nav-container">
        <a href={base} class="nav-brand"><Logo size="small" /></a>
        <ul class="nav-links">
          {nav.map(item => (
            <li>
              <a href={`${base}${item.link.replace('/', '')}`}>{item.text}</a>
            </li>
          ))}
        </ul>
        <a href={`${base}browse`} class="nav-search nav-browse" title="文章树">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 7h18M3 12h18M3 17h18"></path>
            <circle cx="6" cy="7" r="1.5" fill="currentColor"></circle>
            <circle cx="6" cy="12" r="1.5" fill="currentColor"></circle>
            <circle cx="6" cy="17" r="1.5" fill="currentColor"></circle>
            <circle cx="18" cy="7" r="1.5" fill="currentColor"></circle>
            <circle cx="18" cy="12" r="1.5" fill="currentColor"></circle>
            <circle cx="18" cy="17" r="1.5" fill="currentColor"></circle>
          </svg>
          <span>文章树</span>
        </a>
      </div>
    </nav>

    <!-- 主内容 -->
    <main class="main-content">
      <slot />
    </main>

    <!-- 页脚 -->
    <footer class="footer">
      <p>{footer.message}</p>
      <p class="copyright">{footer.copyright}</p>
    </footer>

    <style>
      .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 56px;
        background: rgba(250, 248, 246, 0.85);
        backdrop-filter: saturate(180%) blur(12px);
        border-bottom: 1px solid var(--divider);
        z-index: 100;
      }

      .nav-container {
        max-width: 1200px;
        margin: 0 auto;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
      }

      .nav-brand {
        display: inline-flex;
        text-decoration: none;
      }

      .nav-links {
        display: flex;
        gap: 20px;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .nav-links a {
        color: var(--text-2);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        transition: color 0.2s;
        position: relative;
      }

      .nav-links a::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 50%;
        width: 0;
        height: 2px;
        background: var(--gradient-primary);
        border-radius: 1px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        transform: translateX(-50%);
      }

      .nav-links a:hover,
      .nav-links a.active {
        color: var(--brand-1);
      }

      .nav-links a:hover::after,
      .nav-links a.active::after {
        width: 70%;
      }

      .nav-search {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        background: var(--bg-soft);
        border: 1px solid var(--divider);
        border-radius: 20px;
        color: var(--text-2);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .nav-search:hover {
        background: var(--gradient-primary);
        color: white;
        border-color: transparent;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(141, 123, 158, 0.25);
      }

      .nav-search svg {
        transition: transform 0.3s ease;
      }

      .nav-search:hover svg {
        transform: scale(1.1);
      }

      .nav-search.nav-browse {
        margin-left: 8px;
      }

      .main-content {
        padding-top: 56px;
        min-height: calc(100vh - 56px - 80px);
      }

      .footer {
        border-top: 1px solid var(--divider);
        padding: 40px 24px;
        text-align: center;
        color: var(--text-3);
      }

      .footer p {
        margin: 0.5rem 0;
        font-size: 0.9rem;
      }

      .copyright {
        font-size: 0.85rem;
      }

      @media (max-width: 768px) {
        .nav-container {
          padding: 0 16px;
        }

        .nav-links {
          gap: 12px;
        }

        .nav-links a {
          font-size: 0.85rem;
        }

        .nav-search span {
          display: none;
        }

        .nav-search {
          padding: 8px;
        }

        .nav-brand :global(.sub),
        .nav-brand :global(.sep) {
          display: none;
        }
      }
    </style>

    <script is:inline>
      // 将 base 路径暴露给客户端
      window.__SITE_BASE__ = '{base}';
    </script>
  </body>
</html>
