---
// MGL Logo 组件 - 莫兰迪浅色主题
// Props: size = 'large' | 'small' (默认 'large')
const { size = 'large' } = Astro.props;
---

{size === 'small' ? (
  <div class="nav-logo">
    <span class="prompt">&gt;_</span>
    <span class="typing">MGL<span class="nav-cur"></span></span>
    <span class="sep"></span>
    <span class="sub">用代码书写无限可能</span>
  </div>
) : (
  <div class="logo-card">
    <div class="accent"></div>
    <div class="inner">
      <div class="bar">
        <span class="d r"></span>
        <span class="d y"></span>
        <span class="d g"></span>
        <span class="fname">mgl.py</span>
      </div>
      <div class="code">
        <div class="ln">
          <span class="nr">1</span>
          <span class="k">class</span> <span class="c">MGL</span><span class="o">:</span>
        </div>
        <div class="ln">
          <span class="nr">2</span>
          <span class="s">  "用代码书写无限可能"</span>
          <span class="cur"></span>
        </div>
      </div>
      <div class="tag">
        <span class="t">探索技术</span>
        <span class="td"></span>
        <span class="t">记录生活</span>
        <span class="td"></span>
        <span class="t">永远好奇</span>
        <span class="th"># ∞</span>
      </div>
    </div>
  </div>
)}

<style>
  /* ===== 大尺寸 - 首页代码卡片 ===== */
  .logo-card {
    display: inline-flex;
    align-items: stretch;
    background: var(--bg-elv);
    border: 1px solid var(--divider);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    cursor: default;
    transition: all 0.35s ease;
  }

  .logo-card:hover {
    border-color: rgba(141, 123, 158, 0.25);
    box-shadow: 0 20px 56px rgba(141, 123, 158, 0.15), 0 0 0 1px rgba(141, 123, 158, 0.06);
    transform: translateY(-2px);
  }

  .accent {
    width: 3px;
    flex-shrink: 0;
    background: var(--gradient-primary);
  }

  .inner {
    display: flex;
    flex-direction: column;
    padding: 12px 18px 12px 14px;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 5px;
    padding-bottom: 8px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--divider);
  }

  .d {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .d.r { background: #e8837c; }
  .d.y { background: #f0c67a; }
  .d.g { background: #96a899; }

  .fname {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-3);
    letter-spacing: 0.5px;
    margin-left: 5px;
  }

  .code {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ln {
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1.7;
    white-space: nowrap;
  }

  .nr {
    color: var(--text-3);
    opacity: 0.4;
    font-size: 10px;
    width: 18px;
    display: inline-block;
    text-align: right;
    margin-right: 10px;
    user-select: none;
  }

  .k { color: var(--brand-1); }
  .c { color: #a392b3; font-weight: 600; }
  .o { color: #8d9bab; }
  .s { color: #96a899; }

  .cur {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: var(--brand-1);
    margin-left: 3px;
    vertical-align: text-bottom;
    animation: blink 1s step-end infinite;
    opacity: 0.6;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .tag {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--divider);
  }

  .t {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-3);
    letter-spacing: 1px;
  }

  .td {
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: var(--brand-1);
    opacity: 0.3;
  }

  .th {
    font-family: var(--font-mono);
    color: var(--brand-1);
    opacity: 0.4;
    font-size: 10px;
  }

  /* ===== 小尺寸 - 导航栏终端风格 ===== */
  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    cursor: default;
    white-space: nowrap;
  }

  .prompt {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--brand-1);
    letter-spacing: -0.5px;
  }

  .typing {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-1);
    letter-spacing: 0.02em;
  }

  .nav-cur {
    display: inline-block;
    width: 1.5px;
    height: 0.95em;
    background: var(--brand-1);
    margin-left: 1px;
    vertical-align: text-bottom;
    animation: blink 1s step-end infinite;
    opacity: 0.6;
  }

  .sep {
    width: 1px;
    height: 14px;
    background: var(--divider);
    margin: 0 2px;
  }

  .sub {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-3);
    letter-spacing: 0.02em;
  }
</style>
