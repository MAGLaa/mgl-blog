---
import { siteConfig } from '../config/site.js';

const { posts } = Astro.props;
const { base } = siteConfig;

function formatDate(dateStr) {
  if (!dateStr) return '';
  const [y, m, d] = dateStr.split('-');
  return `${y} 年 ${parseInt(m)} 月 ${parseInt(d)} 日`;
}
---

<div class="post-list">
  {posts.length > 0 ? (
    <div class="posts-grid">
      {posts.map(post => (
        <a 
          href={`${base}${post.url.replace('/', '')}`} 
          class="post-card"
        >
          <div class="post-card-header">
            <h3 class="post-card-title">{post.title}</h3>
            <span class="post-card-date">{formatDate(post.date)}</span>
          </div>
          {post.summary && (
            <p class="post-card-summary">{post.summary}</p>
          )}
          <div class="post-card-footer">
            <span class="post-card-reading-time">📖 {post.readingTime}</span>
            <span class="post-card-category">{post.category}</span>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <p>暂无文章</p>
    </div>
  )}
</div>

<style>
  .post-list {
    margin-top: 32px;
  }

  .posts-grid {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .post-card {
    display: block;
    padding: 24px;
    border: 1px solid var(--divider);
    border-radius: var(--radius-lg);
    background: var(--bg-elv);
    text-decoration: none;
    color: var(--text-1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .post-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--gradient-primary);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }

  .post-card:hover::before {
    opacity: 1;
  }

  .post-card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .post-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-1);
    transition: color 0.2s;
  }

  .post-card:hover .post-card-title {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .post-card-date {
    font-size: 0.85rem;
    color: var(--text-3);
    white-space: nowrap;
  }

  .post-card-summary {
    margin: 0 0 16px;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-2);
  }

  .post-card-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.85rem;
  }

  .post-card-reading-time {
    color: var(--text-3);
  }

  .post-card-category {
    padding: 2px 12px;
    background: var(--brand-soft);
    color: var(--brand-1);
    border-radius: 20px;
    font-weight: 500;
    font-size: 0.8rem;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-3);
    font-size: 1.1rem;
  }

  @media (max-width: 640px) {
    .post-card {
      padding: 20px;
    }

    .post-card-title {
      font-size: 1.05rem;
    }

    .post-card-header {
      flex-direction: column;
      gap: 4px;
    }
  }
</style>
