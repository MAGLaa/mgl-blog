---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { siteConfig } from '../config/site.js';

const { base } = siteConfig;
const { home } = {
  home: {
    hero: {
      name: 'MGL',
      text: '用代码书写无限可能',
      tagline: '探索技术 · 实战项目 · 记录生活 · 永远好奇，永远热血',
      actions: [
        { theme: 'brand', text: '🚀 开始探索', link: '/posts/tech/' },
        { theme: 'alt', text: '🧪 项目实战', link: '/posts/project/' },
        { theme: 'alt', text: '🌈 生活随笔', link: '/posts/life/' }
      ]
    },
    features: [
      {
        icon: '⚡',
        title: '技术笔记',
        details: '编程修炼、架构探索、AI 实践、Bug 攻克，用技术改变世界',
        link: '/posts/tech/'
      },
      {
        icon: '🚀',
        title: '项目实战',
        details: '完整项目开发流程、实战经验总结、踩坑记录与解决方案',
        link: '/posts/project/'
      },
      {
        icon: '🌈',
        title: '生活随笔',
        details: '生活灵感、读书心得、兴趣探索，记录每一刻精彩',
        link: '/posts/life/'
      }
    ]
  }
};
---

<BaseLayout>
  <!-- Hero 区域 -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-bg-2"></div>
    
    <div class="hero-content">
      <div class="hero-logo">
        <Logo />
      </div>
      
      <div class="hero-actions">
        {home.hero.actions.map(action => (
          <a 
            href={`${base}${action.link.replace('/', '')}`} 
            class={`btn btn-${action.theme}`}
          >
            {action.text}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Features 区域 -->
  <section class="features">
    {home.features.map((feature, index) => (
      <a 
        href={`${base}${feature.link.replace('/', '')}`} 
        class="feature-card"
        style={`animation-delay: ${0.2 + index * 0.15}s`}
      >
        <div class="feature-icon">{feature.icon}</div>
        <h3 class="feature-title">{feature.title}</h3>
        <p class="feature-details">{feature.details}</p>
      </a>
    ))}
  </section>

  <style>
    .hero {
      position: relative;
      padding: 80px 24px 40px;
      overflow: hidden;
      text-align: center;
    }

    .hero-bg {
      position: absolute;
      top: -50%;
      left: -20%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle, rgba(141, 123, 158, 0.08) 0%, transparent 70%);
      border-radius: 50%;
      animation: float-blob 8s ease-in-out infinite;
      pointer-events: none;
    }

    .hero-bg-2 {
      position: absolute;
      bottom: -30%;
      right: -10%;
      width: 550px;
      height: 550px;
      background: radial-gradient(circle, rgba(196, 164, 160, 0.08) 0%, transparent 70%);
      border-radius: 50%;
      animation: float-blob 10s ease-in-out infinite reverse;
      pointer-events: none;
    }

    @keyframes float-blob {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(30px, -20px) scale(1.05); }
      66% { transform: translate(-20px, 15px) scale(0.95); }
    }

    .hero-logo {
      display: flex;
      justify-content: center;
      margin-bottom: 2rem;
      animation: fade-in-up 0.7s ease-out both;
    }

    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 800px;
      margin: 0 auto;
    }

    .hero-actions {
      display: flex;
      gap: 14px;
      justify-content: center;
      margin-top: 2rem;
      animation: fade-in-up 0.7s ease-out 0.4s both;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      height: 44px;
      line-height: 44px;
      padding: 0 28px;
      border-radius: 10px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-brand {
      background: var(--gradient-primary);
      color: white;
      box-shadow: 0 4px 15px rgba(141, 123, 158, 0.25);
    }

    .btn-brand:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(141, 123, 158, 0.35);
      color: white;
    }

    .btn-alt {
      border: 1.5px solid var(--divider);
      background: var(--bg-elv);
      color: var(--text-1);
    }

    .btn-alt:hover {
      border-color: var(--brand-1);
      color: var(--brand-1);
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
    }

    .features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
      max-width: 1200px;
      margin: 40px auto;
      padding: 0 24px;
    }

    .feature-card {
      display: block;
      padding: 28px;
      border-radius: var(--radius-lg);
      border: 1px solid var(--divider);
      background: var(--bg-elv);
      text-decoration: none;
      color: var(--text-1);
      transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
      animation: fade-in-up 0.6s ease-out both;
    }

    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--gradient-primary);
      opacity: 0;
      transition: opacity 0.35s;
    }

    .feature-card:hover::before {
      opacity: 1;
    }

    .feature-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
      border-color: transparent;
    }

    .feature-icon {
      font-size: 2rem;
      width: 52px;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg-soft);
      border-radius: var(--radius-md);
      margin-bottom: 16px;
      transition: transform 0.3s ease;
    }

    .feature-card:hover .feature-icon {
      transform: scale(1.1) rotate(5deg);
    }

    .feature-title {
      font-size: 1.15rem;
      font-weight: 700;
      margin: 0 0 8px;
      color: var(--text-1);
    }

    .feature-details {
      color: var(--text-2);
      line-height: 1.7;
      margin: 0;
    }

    @keyframes fade-in-up {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 768px) {
      .hero {
        padding: 40px 16px 20px;
      }

      .hero-logo {
        margin-bottom: 1.5rem;
      }

      .hero-actions {
        flex-direction: column;
        align-items: center;
      }

      .btn {
        width: 100%;
        max-width: 240px;
        justify-content: center;
      }
    }
  </style>
</BaseLayout>
