---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import { siteConfig } from '../../../config/site.js';
import { loadPosts } from '../../../lib/posts.js';

export function getStaticPaths() {
  const { categories } = siteConfig;
  return Object.keys(categories).map(dir => ({
    params: { category: dir }
  }));
}

const { category } = Astro.params;
const { base, categories } = siteConfig;
const categoryConfig = categories[category];
const posts = loadPosts().filter(p => p.categoryDir === category);
---

<BaseLayout title={`${categoryConfig.icon} ${categoryConfig.name}`} description={categoryConfig.description}>
  <div class="category-page">
    <!-- 分类标题 -->
    <header class="category-header">
      <h1>{categoryConfig.icon} {categoryConfig.name}</h1>
      <p class="category-desc">{categoryConfig.description}</p>
      <span class="post-count">共 {posts.length} 篇文章</span>
    </header>

    <!-- 文章列表 -->
    <PostList posts={posts} />
  </div>

  <style>
    .category-page {
      max-width: 900px;
      margin: 0 auto;
      padding: 40px 24px;
    }

    .category-header {
      text-align: center;
      margin-bottom: 48px;
      padding: 48px 24px;
      background: var(--bg-elv);
      border-radius: var(--radius-lg);
      border: 1px solid var(--divider);
    }

    .category-header h1 {
      font-size: 2.2rem;
      font-weight: 800;
      margin: 0 0 12px;
      background: var(--gradient-primary);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .category-desc {
      color: var(--text-2);
      font-size: 1.05rem;
      margin: 0 0 16px;
      line-height: 1.8;
    }

    .post-count {
      display: inline-block;
      padding: 4px 16px;
      background: var(--brand-soft);
      color: var(--brand-1);
      border-radius: 20px;
      font-size: 0.9rem;
      font-weight: 500;
    }
  </style>
</BaseLayout>
